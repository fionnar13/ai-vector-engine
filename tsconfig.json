// PHASE E Decision 1 - TypeScript Option A (JSDoc + checkJs on src-js).
//
// The legacy TypeScript tree src/core/**/*.ts (plus tests/run.ts and
// tests/architecture.test.ts from the same era) is INTENTIONALLY EXCLUDED:
// it is frozen as a design document, has never compiled, and must not
// block typecheck. Do NOT delete it.
//
// Incremental adoption starts from the leaf modules (vec2, matrix, bbox).
// Widen "include" as each further src-js module gains JSDoc types.
// Option B (per-module .ts migration) remains possible on top of this setup.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src-js/vec2.js", "src-js/matrix.js", "src-js/bbox.js"]
}
